PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/contributor-website
CLIENT_ORIGIN=http://localhost:5173

JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin

CONTRIBUTOR_NAME=Contributor User
CONTRIBUTOR_EMAIL=contributor@example.com
CONTRIBUTOR_PASSWORD=change-me-contributor

# Submission file limits. MAX_FILE_SIZE is bytes. UPLOAD_DIR is optional.
MAX_FILE_SIZE=5242880
MAX_FILES=10
# UPLOAD_DIR=

# Hours before a job deadline when a contributor receives one reminder.
DEADLINE_REMINDER_HOURS=24
